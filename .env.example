# Copy to .env.local (or set in your host's dashboard) and fill in.

# Public URL of the site, no trailing slash. Used in share links, scorecard previews and the X callback.
NEXT_PUBLIC_SITE_URL=https://www.playhaunt.xyz

# Launch moment for the countdown (ISO, with timezone). Placeholder until the team confirms.
NEXT_PUBLIC_LAUNCH_AT=2026-10-31T00:00:00Z
# Game round: the top 5 each win 50,000 $HAUNT. Ends 2 hours before Halloween by default (22:00 UTC on Oct 30).
NEXT_PUBLIC_ROUND_END_AT=2026-10-30T22:00:00Z
# The Cellar (second room) opens at this time. Defaults to the launch time.
NEXT_PUBLIC_CELLAR_AT=

# Token details. The token section shows the address, copy button and buy button once both are set.
NEXT_PUBLIC_TOKEN_ADDRESS=
NEXT_PUBLIC_BUY_URL=
# Chain name and block explorer base URL (no trailing slash; links add /token/, /tx/, /address/)
NEXT_PUBLIC_CHAIN_NAME=Robinhood Chain
NEXT_PUBLIC_EXPLORER_URL=

# REQUIRED in production: a database. Use ONE of these.
# Google Sheet via Apps Script, like the militia site (setup: scripts/apps-script/README.md).
GOOGLE_SHEETS_WEBAPP_URL=
# Must match SHARED_SECRET in the Apps Script project's Script Properties.
SHEETS_WEBHOOK_SECRET=
# Or Upstash Redis for heavy traffic (upstash.com, REST API credentials). Takes priority over the sheet when set.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# REQUIRED in production. Long random string that signs sign in and admin cookies.
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Sign in: players type their X username (the default, no X app needed).
# Optional: set AUTH_MODE=x to switch to Sign in with X instead (developer.x.com, OAuth 2.0, type "Web App",
# callback https://www.playhaunt.xyz/api/auth/x/callback) and fill in the two keys below.
AUTH_MODE=
X_CLIENT_ID=
X_CLIENT_SECRET=
# Prize eligibility for X accounts
MIN_ACCOUNT_DAYS=30
MIN_FOLLOWERS=10

# Cloudflare Turnstile bot check on posting scores (recommended with prizes)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Password for /admin (review winners, hide runs, ban accounts, export CSV with wallets)
ADMIN_KEY=

# ---- The 2,000: $HAUNT allocation claims ----
# Robinhood Chain network details, from the team's chain documentation.
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_RPC_URL=
# $HAUNT decimals, used to size each 100,000 allocation in base units when the list is frozen.
NEXT_PUBLIC_TOKEN_DECIMALS=18
# The Merkle distributor deployed with the frozen list's root (see /admin/airdrop).
NEXT_PUBLIC_CLAIM_CONTRACT=
# Set to true only after the contract is funded. Even then the claim button stays off until launch,
# and unless the contract's root matches the frozen list and it holds the tokens.
NEXT_PUBLIC_CLAIM_OPEN=false

# ---- Game rewards: top 5 of Round 1, 50,000 $HAUNT each, claimed from their own contract ----
# A second Merkle distributor, deployed with the winners' root from /admin (Round 1 tab) and funded with 250,000 $HAUNT.
NEXT_PUBLIC_REWARDS_CONTRACT=
NEXT_PUBLIC_REWARDS_CLAIM_OPEN=false

# The airdrop post that the like, repost and comment tasks point at, and where permit cards get posted.
# Any x.com or twitter.com status link.
NEXT_PUBLIC_AIRDROP_POST=https://x.com/PlayhauntRh/status/...
